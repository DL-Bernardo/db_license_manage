<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.license</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Licensing" string="Licensing" data-key="db_license_manage">
                    <h2>License Management</h2>
                    <div class="row mt16 o_settings_container" name="license_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">License Token</span>
                                <div class="text-muted">
                                    Paste the license token provided by your software vendor.
                                </div>
                                <div class="content-group mt16">
                                    <field name="license_token"/>
                                    <field name="public_key" groups="base.group_system" placeholder="Paste RSA Public Key here..." style="font-family: monospace; font-size: 0.85rem;"/>
                                    <div class="mt16">
                                        <field name="license_state" widget="badge"
                                            decoration-success="license_state == 'valid'"
                                            decoration-warning="license_state == 'warning'"
                                            decoration-danger="license_state in ['expired', 'invalid']"/>
                                        <field name="license_status_display" readonly="1" class="oe_inline ms-2 text-muted"/>
                                    </div>
                                    <div class="mt8" attrs="{'invisible': [('license_expiration_date', '=', False)]}">
                                        <span>Valid from: </span>
                                        <field name="license_start_date" readonly="1" class="oe_inline"/>
                                        <span class="mx-2">to</span>
                                        <field name="license_expiration_date" readonly="1" class="oe_inline"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="close_on_browser_exit"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="close_on_browser_exit" string="Session Control"/>
                                <div class="text-muted">
                                    Force session termination when the user closes the browser.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Email Alerts &amp; Notifications</span>
                                <div class="text-muted">
                                    Configure email addresses to receive license status notifications.
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="license_company_notification_email" class="col-lg-4 o_light_label" string="Company Email:"/>
                                        <field name="license_company_notification_email" placeholder="e.g. admin@company.com"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="license_support_email" class="col-lg-4 o_light_label" string="Support Email (CC):"/>
                                        <field name="license_support_email" placeholder="suporte@digitalub.ao"/>
                                    </div>
                                    <div class="mt16">
                                        <button name="action_send_license_status_email" type="object" string="📧 Send License Status Email Now" class="btn-primary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
